# a10mini (YMC A10 Mini, Rockchip RK3326)
# RK3326 is 4x Cortex-A35 (armv8-a). Built natively inside a chroot of the
# device's own Ubuntu 19.10 rootfs (gcc 9.2, glibc 2.30) so the binaries
# link against exactly the SDL2/libc the device ships.
# libdrm: platform.c sets the panel gamma LUT through SDL's KMSDRM fd.
ARCH = -mtune=cortex-a35 -march=armv8-a -O3 -I/usr/include/libdrm
LIBS = -flto -ldrm
SDL = SDL2
